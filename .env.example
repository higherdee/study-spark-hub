# Copy to .env.local (gitignored). Use NEW/ROTATED keys; do not reuse keys posted in chat.
# VITE_* is public browser configuration. Never prefix a secret with VITE_ or NEXT_PUBLIC_.

# Clerk: browser publishable key + server secret from the SAME instance.
# Live Clerk instances may require the production domain; use a development instance for previews.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Turso: server credentials (never VITE_*).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare R2: server credentials only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=syllaboss

# Supabase: only the URL and publishable key belong in browser config.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy service-role variable also supported; use one server secret variable, not both.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Paystack: keep test and live configurations separate.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Basch/Bachs checkout: server-only. No VITE_BASCH_SECRET_KEY.
BASCH_SECRET_KEY=

# Boss AI: server-only. Do not store keys in browser localStorage.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional alternative gateway, if used by your deployment.
LOVABLE_API_KEY=

# Optional external API: server-only.
API_KEY=
API_SECRET=

# Paddle: API keys stay on the server. Never enable production billing in a preview.
PADDLE_LIVE_API_KEY=
PADDLE_SANDBOX_API_KEY=
PADDLE_ENV=sandbox
VITE_PADDLE_ENV=sandbox

# Operational secrets for scheduled/admin integrations, when enabled.
CRON_SECRET=
