/assets/*
  cache-control: public, max-age=31536000, immutable

/downloads/syllaboss.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="Syllaboss.apk"
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/downloads/syllaboss-setup.exe
  Content-Type: application/vnd.microsoft.portable-executable
  Content-Disposition: attachment; filename="Syllaboss-Setup.exe"
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/downloads/syllaboss.AppImage
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Syllaboss.AppImage"
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
